{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-31",
	"name": "etiquetteness",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"routes": [
		{ "pattern": "etiquetteness.com", "custom_domain": true }
	],
	"observability": {
		"enabled": true
	}
}
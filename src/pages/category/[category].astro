---
import Layout from '../../layouts/Layout.astro';
import EntryCard from '../../components/EntryCard.astro';
import CategoryPills from '../../components/CategoryPills.astro';
import CountryPills from '../../components/CountryPills.astro';
import { CATEGORIES, CATEGORY_META, type Category } from '../../lib/categories';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('etiquette');
  return CATEGORIES.map((category) => ({
    params: { category },
    props: { entries: entries.filter((e) => e.data.category === category) },
  }));
}

const { category } = Astro.params as { category: Category };
const { entries } = Astro.props;
const meta = CATEGORY_META[category];
---

<Layout title={`${meta.label} etiquette`} description={meta.description}>
  <div class="flex items-center gap-3">
    <span class="h-3 w-3 shrink-0 rounded-full" style={`background-color: ${meta.color}`} aria-hidden="true" />
    <h1 class="font-display text-5xl font-semibold">{meta.label}</h1>
  </div>
  <p class="mt-4 max-w-2xl text-lg leading-relaxed text-stone-600">{meta.description}</p>
  <p class="mt-2 text-sm text-stone-500">{entries.length} rule{entries.length === 1 ? '' : 's'}.</p>

  <div class="mt-8 space-y-4">
    <CategoryPills active={category} />
    <CountryPills />
  </div>

  {entries.length > 0 ? (
    <>
    <h2 class="sr-only">{meta.label} rules</h2>
    <div class="entry-list mt-8 divide-y divide-stone-200" data-pagefind-ignore>
      {
        entries.map((entry) => (
          <EntryCard
            href={`/etiquette/${entry.id}/`}
            title={entry.data.title}
            country={entry.data.country}
            category={entry.data.category}
            summary={entry.data.summary}
          />
        ))
      }
    </div>
    </>
  ) : (
    <div class="mt-8 rounded-xl border border-dashed border-stone-300 p-10 text-center text-stone-500">
      <p>No {meta.label.toLowerCase()} rules yet, check back soon.</p>
    </div>
  )}
</Layout>

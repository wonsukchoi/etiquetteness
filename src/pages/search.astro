---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Search" description="Search etiquette rules by country, category, or keyword.">
  <h1 class="font-display text-4xl font-semibold">Search</h1>
  <p class="mt-2 text-stone-600">Find a rule by country, category, or keyword.</p>

  <div id="search" class="mt-8" data-pagefind-ignore></div>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (typeof PagefindUI === 'undefined') return;
      new PagefindUI({
        element: '#search',
        showSubResults: false,
        showImages: false,
      });
    });
  </script>
</Layout>

<style is:global>
  #search {
    --pagefind-ui-primary: #1c1917;
    --pagefind-ui-text: #292524;
    --pagefind-ui-background: #fbf9f6;
    --pagefind-ui-border: #e7e5e4;
    --pagefind-ui-font: "Inter", ui-sans-serif, system-ui, sans-serif;
    --pagefind-ui-border-radius: 0.75rem;
  }
</style>

---
import Layout from '../../layouts/Layout.astro';
import { GUIDES, guidePath } from '../../lib/guides';
import { rulePath } from '../../lib/rules';
import { ORGANIZATION_ID, WEBSITE_ID, organizationNode, websiteNode } from '../../lib/organization';
import { FiChevronRight } from 'react-icons/fi';

// Cross-country guide drawn from four rules that already live on the country pages
// (japan/dining-chopstick-rules, vietnam/dining-no-chopsticks-upright,
// korea/dining-rice-left-of-soup, thailand/dining-spoon-and-fork). Every statement
// below restates one of those rules or its cited source; nothing here is new.
const guide = GUIDES.find((g) => g.slug === 'chopstick-etiquette')!;

const rule = {
  japan: rulePath('japan', 'dining-chopstick-rules'),
  vietnam: rulePath('vietnam', 'dining-no-chopsticks-upright'),
  korea: rulePath('korea', 'dining-rice-left-of-soup'),
  thailand: rulePath('thailand', 'dining-spoon-and-fork'),
};

const faqs = [
  {
    q: 'Why should chopsticks never stand upright in rice?',
    a: 'Two chopsticks standing in a bowl of rice look like incense sticks planted at a funeral altar or ancestral shrine. In Japan, Korea and Vietnam the gesture reads as a reference to death, so it unsettles the people at the table even if nobody says so.',
  },
  {
    q: 'Where do I put my chopsticks between bites?',
    a: 'Lay them flat across the top of your bowl or plate, or on a chopstick rest (hashioki in Japan) if the table has one.',
  },
  {
    q: 'Can I pass food from my chopsticks to someone else’s?',
    a: 'Not in Japan. Passing food chopstick to chopstick echoes kotsuage, the funeral rite in which family members pass cremated bones between them. Put the food on the other person’s plate instead, or use the thicker end of your own chopsticks to serve.',
  },
  {
    q: 'Do you eat everything with chopsticks in Korea?',
    a: 'No. The spoon is for rice and soup and the chopsticks are for side dishes. Do not hold the spoon and chopsticks in the same hand at the same time.',
  },
  {
    q: 'Are chopsticks the normal utensil in Thailand?',
    a: 'No. The everyday pairing is a spoon in the right hand with a fork in the left to push food onto it. Chopsticks come out for noodle dishes.',
  },
];

const pageURL = new URL(Astro.url.pathname, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${pageURL}#article`,
      headline: guide.title,
      description: guide.description,
      datePublished: guide.updatedAt,
      dateModified: guide.updatedAt,
      url: pageURL,
      license: 'https://creativecommons.org/licenses/by-nc/4.0/',
      mainEntityOfPage: { '@type': 'WebPage', '@id': pageURL.toString() },
      isPartOf: { '@id': WEBSITE_ID },
      publisher: { '@id': ORGANIZATION_ID },
      author: { '@id': ORGANIZATION_ID },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    websiteNode(Astro.site!),
    organizationNode(Astro.site!),
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: String(Astro.site) },
        { '@type': 'ListItem', position: 2, name: 'Chopstick etiquette', item: pageURL.toString() },
      ],
    },
  ],
};

const link = 'underline decoration-stone-300 underline-offset-4 hover:text-stone-900 hover:decoration-stone-900';
const h2 = 'mt-12 font-display text-3xl font-semibold leading-tight';
---

<Layout title={guide.seoTitle} description={guide.description} type="article">
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-xs text-stone-500">
    <a href="/" class="hover:text-stone-600">Home</a>
    <FiChevronRight aria-hidden="true" size={12} />
    <span aria-current="page">Chopstick etiquette</span>
  </nav>

  <h1 class="mt-4 font-display text-4xl font-semibold leading-tight min-[360px]:text-5xl">{guide.title}</h1>
  <p class="mt-4 max-w-2xl text-lg leading-relaxed text-stone-600">
    The rule that travels is simple: never stand your chopsticks upright in a bowl of rice. In Japan, Korea and
    Vietnam the gesture recalls funeral and ancestral rites, so it unsettles the table far more than ordinary bad
    manners. Everything else changes by country, and in Thailand the spoon and fork come first.
  </p>
  <p class="mt-3 text-sm text-stone-500">
    Last updated <time datetime={guide.updatedAt}>November 20, 2026</time>
  </p>

  <div class="mt-4 max-w-2xl space-y-4 leading-relaxed text-stone-700">
    <h2 class={h2}>Never stand chopsticks upright in rice</h2>
    <p>
      This is the one rule shared by <a class={link} href={rule.japan}>Japan</a>,
      <a class={link} href={rule.korea}>Korea</a> and <a class={link} href={rule.vietnam}>Vietnam</a>, and the reason is the
      same in each: it echoes a funeral or memorial rite.
    </p>
    <ul class="list-disc space-y-2 pl-6">
      <li>
        <strong>Japan:</strong> upright chopsticks in rice resemble incense sticks placed at a Buddhist altar.
      </li>
      <li>
        <strong>Vietnam:</strong> two chopsticks planted in a bowl mirror how incense sticks are placed in rice or sand at a
        funeral altar or ancestral shrine.
      </li>
      <li>
        <strong>Korea:</strong> upright chopsticks carry the same association with the memorial rite (jesa), where the
        setting is arranged as if an ancestor’s spirit will use it.
      </li>
    </ul>
    <p>
      When you pause, lay your chopsticks flat across the top of the bowl or on a chopstick rest. A moment of
      absent-mindedness is enough to make people at the table visibly uncomfortable.
    </p>

    <h2 class={h2}>Japan: the other chopstick taboos</h2>
    <p>
      Japanese children learn a whole set of chopstick taboos (<em>hashi tabu</em>). The second most serious one after
      the upright-in-rice rule is passing food from your chopsticks directly to someone else’s, which mirrors the
      funeral rite <em>kotsuage</em>, where family members pass cremated bones between them. To share food, put it on
      the other person’s plate with your chopsticks, or serve with the opposite, thicker end of your own.
    </p>
    <ul class="list-disc space-y-2 pl-6">
      <li>Do not rub disposable chopsticks together to smooth splinters (<em>kosuribashi</em>); it implies your host gave you cheap ones.</li>
      <li>Do not spear food with a chopstick (<em>tsukibashi</em>). Bring the bowl closer to your mouth if something will not cooperate.</li>
      <li>Do not point with your chopsticks at a person or a dish.</li>
      <li>Do not cross them on the table or on the rest; lay them parallel, tips pointing left.</li>
    </ul>
    <p>
      The full rule, with its source, is on the <a class={link} href={rule.japan}>Japan page</a>.
    </p>

    <h2 class={h2}>Korea: the spoon has its own job</h2>
    <p>
      A Korean place setting puts rice on your left and soup on your right, with the chopsticks and spoon to the
      right of the setting and the spoon on the outside. Use the spoon for rice and soup and the chopsticks for side
      dishes, and never hold both in the same hand at once: set one down before you pick up the other. Reversing the rice
      and soup is itself a memorial-rite layout, which is why older relatives notice it. See the
      <a class={link} href={rule.korea}>Korea page</a>.
    </p>

    <h2 class={h2}>Vietnam: shared dishes, your own chopsticks</h2>
    <p>
      Meals are communal. Expect to serve yourself from the shared plates at the center of the table with your own
      chopsticks instead of getting pre-portioned dishes, and pass dishes or hand things over with your right hand or both
      hands, not your left. See the <a class={link} href={rule.vietnam}>Vietnam page</a>.
    </p>

    <h2 class={h2}>Thailand: spoon and fork first, chopsticks for noodles</h2>
    <p>
      Thai meals are shared family-style, and the everyday utensils are a spoon in your right hand with a fork in your left
      to push food onto it; the fork does not go into your mouth. Chopsticks are for noodle dishes. If a shared plate has no
      serving spoon, ask for one rather than reaching in with your own spoon or fork. See the
      <a class={link} href={rule.thailand}>Thailand page</a>.
    </p>

    <h2 class={h2}>Questions</h2>
    <div class="space-y-6">
      {
        faqs.map((f) => (
          <div>
            <h3 class="font-display text-xl font-semibold">{f.q}</h3>
            <p class="mt-2">{f.a}</p>
          </div>
        ))
      }
    </div>

    <h2 class={h2}>Sources</h2>
    <ul class="list-disc space-y-1 pl-6 text-sm text-stone-600">
      <li><a class={link} href="https://www.nippon.com/en/guide-to-japan/gu020010/" target="_blank" rel="noopener noreferrer">Chopsticks Manners and Traditional Japanese Beliefs – Nippon.com</a></li>
      <li><a class={link} href="https://thesoulofseoul.net/how-to-set-the-table-for-jesa/" target="_blank" rel="noopener noreferrer">How To Set the Jesa Table for Seollal and Chuseok – The Soul of Seoul</a></li>
      <li><a class={link} href="https://culturalatlas.sbs.com.au/vietnamese-culture/vietnamese-culture-etiquette" target="_blank" rel="noopener noreferrer">Vietnamese Culture: Etiquette – Cultural Atlas (SBS)</a></li>
      <li><a class={link} href="https://siam.recipes/blogs/news/table-manners-and-dinner-etiquette-in-thailand" target="_blank" rel="noopener noreferrer">Table manners and dinner etiquette in Thailand – deSIAMCuisine</a></li>
    </ul>
    <p class="text-sm text-stone-500">
      More table rules: <a class={link} href="/category/dining/">all dining etiquette</a>.
    </p>
  </div>
</Layout>

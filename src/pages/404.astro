---
import Layout from '../layouts/Layout.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import ArrowButton from '../components/ArrowButton.astro';
---

<Layout title="Page not found" description="This page doesn't exist.">
  <div class="mx-auto flex max-w-md flex-col items-center py-16 text-center">
    <ImagePlaceholder ratio="4/3" label="404 illustration" class="w-full max-w-xs" />

    <h1 class="mt-10 font-display text-4xl font-semibold leading-tight">
      (404) Looks like the page you're looking for got lost somewhere.
    </h1>
    <p class="mt-4 text-stone-600">
      But hey, on a site about etiquette, even a wrong turn is a chance to be polite about it.
    </p>

    <ArrowButton href="/" class="mt-8">Back to Home</ArrowButton>
  </div>
</Layout>

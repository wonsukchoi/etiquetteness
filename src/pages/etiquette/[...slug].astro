---
import Layout from '../../layouts/Layout.astro';
import EntryCard from '../../components/EntryCard.astro';
import { CATEGORY_META } from '../../lib/categories';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('etiquette');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, entries },
  }));
}

const { entry, entries } = Astro.props;
const { Content } = await render(entry);
const meta = CATEGORY_META[entry.data.category];

const related = entries
  .filter((e) => e.id !== entry.id && e.data.country === entry.data.country)
  .slice(0, 3);

const pageURL = new URL(Astro.url.pathname, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: entry.data.title,
      description: entry.data.summary,
      articleSection: meta.label,
      about: entry.data.country,
      dateModified: entry.data.updatedAt?.toISOString(),
      url: pageURL,
      isPartOf: { '@type': 'WebSite', name: 'Etiquetteness', url: Astro.site },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: String(Astro.site) },
        {
          '@type': 'ListItem',
          position: 2,
          name: entry.data.country,
          item: new URL(`/country/${entry.data.country}`, Astro.site).toString(),
        },
        { '@type': 'ListItem', position: 3, name: entry.data.title, item: pageURL.toString() },
      ],
    },
  ],
};
---

<Layout title={entry.data.title} description={entry.data.summary} type="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div>
    <p class="text-sm font-medium uppercase tracking-widest text-stone-400">
      {meta.emoji} {meta.label} · {entry.data.country}
    </p>

    <h1 class="mt-3 font-display text-5xl font-semibold leading-tight">
      {entry.data.title}
    </h1>

    <p class="mt-4 text-xl leading-relaxed text-stone-600">{entry.data.summary}</p>

    <div class="mt-6 flex flex-wrap gap-2">
      <a
        href={`/country/${entry.data.country}`}
        class="rounded-full border border-stone-200 px-3 py-1 text-xs font-medium capitalize text-stone-600 hover:border-stone-400"
      >
        {entry.data.country}
      </a>
      <a
        href={`/category/${entry.data.category}`}
        class="rounded-full border border-stone-200 px-3 py-1 text-xs font-medium capitalize text-stone-600 hover:border-stone-400"
      >
        {entry.data.category}
      </a>
      <span class="rounded-full border border-stone-200 px-3 py-1 text-xs font-medium capitalize text-stone-600">
        {entry.data.severity}
      </span>
    </div>

    <article class="prose prose-stone mt-10 max-w-none prose-p:leading-relaxed">
      <Content />
    </article>

    {entry.data.source && (
      <p class="mt-10 border-t border-stone-200 pt-4 text-xs text-stone-400">
        Source:{' '}
        {entry.data.sourceUrl ? (
          <a href={entry.data.sourceUrl} target="_blank" rel="noopener noreferrer" class="underline hover:text-stone-600">
            {entry.data.source}
          </a>
        ) : (
          entry.data.source
        )}
      </p>
    )}
  </div>

  {related.length > 0 && (
    <div class="mt-16 border-t border-stone-200 pt-10" data-pagefind-ignore>
      <h2 class="font-display text-2xl font-semibold capitalize">More from {entry.data.country}</h2>
      <div class="mt-6 divide-y divide-stone-200">
        {related.map((r) => (
          <EntryCard
            href={`/etiquette/${r.id}`}
            title={r.data.title}
            country={r.data.country}
            category={r.data.category}
            summary={r.data.summary}
          />
        ))}
      </div>
    </div>
  )}
</Layout>

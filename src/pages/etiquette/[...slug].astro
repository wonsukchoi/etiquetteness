---
import Layout from '../../layouts/Layout.astro';
import EntryCard from '../../components/EntryCard.astro';
import { CATEGORY_META } from '../../lib/categories';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('etiquette');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, entries },
  }));
}

const { entry, entries } = Astro.props;
const { Content } = await render(entry);
const meta = CATEGORY_META[entry.data.category];

const related = entries
  .filter((e) => e.id !== entry.id && e.data.country === entry.data.country)
  .slice(0, 3);
---

<Layout title={entry.data.title} description={entry.data.summary}>
  <div>
    <p class="font-serif text-sm uppercase tracking-widest text-stone-400">
      {meta.emoji} {meta.label} · {entry.data.country}
    </p>

    <h1 class="mt-3 font-serif text-4xl font-medium leading-tight tracking-tight">
      {entry.data.title}
    </h1>

    <p class="mt-4 text-xl leading-relaxed text-stone-600">{entry.data.summary}</p>

    <div class="mt-6 flex flex-wrap gap-2">
      <a
        href={`/country/${entry.data.country}`}
        class="rounded-full border border-stone-200 px-3 py-1 text-xs font-medium capitalize text-stone-600 hover:border-stone-400"
      >
        {entry.data.country}
      </a>
      <a
        href={`/category/${entry.data.category}`}
        class="rounded-full border border-stone-200 px-3 py-1 text-xs font-medium capitalize text-stone-600 hover:border-stone-400"
      >
        {entry.data.category}
      </a>
      <span class="rounded-full border border-stone-200 px-3 py-1 text-xs font-medium capitalize text-stone-600">
        {entry.data.severity}
      </span>
    </div>

    <article class="prose prose-stone mt-10 max-w-none prose-p:leading-relaxed">
      <Content />
    </article>

    {entry.data.source && (
      <p class="mt-10 border-t border-stone-200 pt-4 text-xs text-stone-400">
        Source: {entry.data.source}
      </p>
    )}
  </div>

  {related.length > 0 && (
    <div class="mt-16 border-t border-stone-200 pt-10">
      <h2 class="font-serif text-xl font-medium capitalize">More from {entry.data.country}</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-3">
        {related.map((r) => (
          <EntryCard
            href={`/etiquette/${r.id}`}
            title={r.data.title}
            country={r.data.country}
            category={r.data.category}
            summary={r.data.summary}
          />
        ))}
      </div>
    </div>
  )}
</Layout>

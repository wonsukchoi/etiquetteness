---
interface Props {
  href: string;
  variant?: 'solid' | 'ghost';
  class?: string;
}

const { href, variant = 'solid', class: className = '' } = Astro.props;

const isSolid = variant === 'solid';
---

<a
  href={href}
  class:list={[
    'inline-flex items-center gap-3 rounded-full text-sm font-medium transition-colors',
    isSolid
      ? 'bg-stone-900 py-1.5 pl-5 pr-1.5 text-white hover:bg-stone-700'
      : 'py-1 text-stone-900 underline decoration-stone-300 underline-offset-4 hover:decoration-stone-900',
    className,
  ]}
>
  <slot />
  <span
    class:list={[
      'flex h-7 w-7 shrink-0 items-center justify-center rounded-full',
      isSolid ? 'bg-white/15' : 'border border-stone-300',
    ]}
    aria-hidden="true"
  >
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <path d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  </span>
</a>

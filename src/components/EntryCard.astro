---
import { CATEGORY_META, type Category } from '../lib/categories';
import { COUNTRY_META, type Country } from '../lib/countries';

interface Props {
  href: string;
  title: string;
  country: string;
  category: Category;
  summary: string;
}

const { href, title, country, category, summary } = Astro.props;
const meta = CATEGORY_META[category];
const countryLabel = COUNTRY_META[country as Country]?.label ?? country.replace(/-/g, ' ');
---

<a
  href={href}
  aria-label={`${title}, ${summary}`}
  data-entry-row
  data-category={category}
  data-country={country}
  class="entry-row group flex items-start gap-4 py-4 sm:items-center transition-colors duration-200 hover:bg-stone-100/60 -mx-3 px-3 rounded-lg"
>
  <span class="entry-index w-6 shrink-0 text-right font-mono text-xs tabular-nums text-stone-300" aria-hidden="true"></span>
  <span class="h-1.5 w-1.5 shrink-0 rounded-full" style={`background-color: ${meta.color}`} aria-hidden="true"></span>
  {/* Below sm the category label sits under the title instead of beside it: beside it, the label,
      the index and the dot squeezed a truncated title to about 20 characters on a phone (375 px),
      so the rule itself was cut off in the list. From sm up the row is as before. */}
  <div class="flex min-w-0 flex-1 flex-col gap-1 sm:flex-row sm:items-center sm:gap-4">
    <h3 class="min-w-0 font-display text-lg font-semibold leading-snug text-stone-900 group-hover:text-stone-600 sm:flex-1 sm:truncate">
      {title}
    </h3>
    <div class="flex shrink-0 items-center gap-1.5 text-xs font-medium uppercase tracking-wide text-stone-500">
      <span class="hidden capitalize sm:inline">{countryLabel}</span>
      <span class="hidden sm:inline" aria-hidden="true">·</span>
      <span>{meta.label}</span>
    </div>
  </div>
</a>

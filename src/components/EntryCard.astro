---
import { CATEGORY_META, type Category } from '../lib/categories';

interface Props {
  href: string;
  title: string;
  country: string;
  category: Category;
  summary: string;
}

const { href, title, country, category, summary } = Astro.props;
const meta = CATEGORY_META[category];
---

<a
  href={href}
  aria-label={`${title}, ${summary}`}
  class="group flex items-center justify-between gap-4 py-4 transition-colors duration-200 hover:bg-stone-100/60 -mx-3 px-3 rounded-lg"
>
  <h3 class="font-serif text-lg font-medium leading-snug text-stone-900 group-hover:text-stone-600">
    {title}
  </h3>
  <div class="flex shrink-0 items-center gap-2 text-xs font-medium uppercase tracking-wide text-stone-400">
    <span aria-hidden="true">{meta.emoji}</span>
    <span class="hidden sm:inline">{country}</span>
    <span class="hidden sm:inline" aria-hidden="true">·</span>
    <span>{meta.label}</span>
  </div>
</a>

---
import { getCollection } from 'astro:content';
import { CATEGORIES, CATEGORY_META } from '../lib/categories';

interface Props {
  active?: string;
  // Homepage mode: pills carry data-filter-* hooks for the client-side
  // combined category+country filter instead of navigating to /category/x.
  filterable?: boolean;
}

const { active, filterable = false } = Astro.props;

const entries = await getCollection('etiquette');
const counts = Object.fromEntries(
  CATEGORIES.map((c) => [c, entries.filter((e) => e.data.category === c).length])
);
---

<nav class="flex flex-wrap items-center gap-x-6 gap-y-3 border-b border-stone-200 text-sm" aria-label="Filter by category">
  <a
    href="/"
    data-filter-key={filterable ? 'category' : undefined}
    data-filter-value={filterable ? '' : undefined}
    class:list={[
      'flex min-h-11 items-center gap-1.5 border-b-2 pb-3 -mb-px font-medium transition-colors',
      !active
        ? 'border-stone-900 text-stone-900'
        : 'border-transparent text-stone-500 hover:text-stone-900',
    ]}
  >
    All <span class="text-stone-400">{entries.length}</span>
  </a>
  {
    CATEGORIES.map((category) => (
      <a
        href={`/category/${category}`}
        data-filter-key={filterable ? 'category' : undefined}
        data-filter-value={filterable ? category : undefined}
        class:list={[
          'flex min-h-11 items-center gap-1.5 border-b-2 pb-3 -mb-px font-medium transition-colors',
          active === category
            ? 'text-stone-900'
            : 'border-transparent text-stone-500 hover:text-stone-900',
        ]}
        style={active === category ? `border-color: ${CATEGORY_META[category].color}` : undefined}
      >
        <span
          class="h-1.5 w-1.5 shrink-0 rounded-full"
          style={`background-color: ${CATEGORY_META[category].color}`}
          aria-hidden="true"
        />
        {CATEGORY_META[category].label} <span class="text-stone-400">{counts[category]}</span>
      </a>
    ))
  }
</nav>

---
interface Props {
  ratio?: string;
  label?: string;
  class?: string;
  rounded?: string;
}

const { ratio = '4/3', label = 'Image placeholder', class: className = '', rounded = 'rounded-xl' } = Astro.props;
---

<div
  class={`relative flex items-center justify-center overflow-hidden border border-dashed border-stone-300 bg-stone-100 ${rounded} ${className}`}
  style={`aspect-ratio: ${ratio};`}
  role="img"
  aria-label={label}
>
  <div class="flex flex-col items-center gap-2 text-stone-400">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="2" />
      <circle cx="9" cy="9" r="1.75" />
      <path d="M21 15l-5-5-9 9" />
    </svg>
    <span class="text-xs font-medium">{label}</span>
  </div>
</div>
